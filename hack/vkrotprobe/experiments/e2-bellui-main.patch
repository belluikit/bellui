+// e3Drain is a #909 experiment: drain the device and wait before a reconfigure.
+func (d *Device) e3Drain(where string) {
+	d.device.Poll(true, nil)
+	time.Sleep(100 * time.Millisecond)
+	bellui.LogError(fmt.Sprintf("E3 reconfigure %s %dx%d", where, d.config.Width, d.config.Height), nil)
