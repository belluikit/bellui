package main

import (
	"github.com/belluikit/bellui"
	"github.com/belluikit/bellui/app"
)

func init() {
	app.SetMetadata(bellui.AppMetadata{
		ID: {{printf "%q" .AppID}},
		Name: {{printf "%q" .Name}},
		Version: {{printf "%q" .AppVersion}},
		Build: {{.AppBuild}},
		Icon: {{.ResGoString}},
		Release: {{.Release}},
		Custom: map[string]string{
			{{range $key, $value := .CustomMetadata}}
			{{printf "%q" $key}}: {{printf "%q" $value}},
			{{end}}
		},
		Migrations: map[string]bool{
        	{{range $key, $value := .Migrations}}
        	{{printf "%q" $key}}: {{$value}},
        	{{end}}
        },
	})
}

