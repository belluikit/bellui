								</widget>
								<widget pos="0,72" size="79x32" type="*widget.menuItem">
									<text pos="8,8" size="43x16">Recent</text>
									<image pos="59,6" rsc="menuExpandIcon" size="iconInlineSize" themed="foreground"/>
								</widget>
							</container>
						</widget>
					</widget>
				</widget>
			</widget>
		</container>
	</content>
