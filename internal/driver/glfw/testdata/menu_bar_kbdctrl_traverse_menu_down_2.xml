					<text pos="8,8" size="41x16">Button</text>
				</widget>
			</widget>
			<widget size="300x24" type="*glfw.MenuBar">
				<widget size="300x24" type="*widget.Shadow">
					<boxShadow blurRadius="6" color="shadow" cornerRadius="4" offsetY="2" size="300x24"/>
				</widget>
				<widget size="300x300" type="*glfw.menuBarUnderlay">
				</widget>
				<rectangle fillColor="background" size="300x24"/>
				<container pos="8,0" size="284x24">
					<widget size="37x24" type="*glfw.menuBarItem">
						<rectangle fillColor="focus" radius="4" size="37x24"/>
