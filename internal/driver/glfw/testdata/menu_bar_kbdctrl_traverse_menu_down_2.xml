					</widget>
					<widget pos="41,0" size="39x24" type="*glfw.menuBarItem">
						<text pos="8,4" size="23x16">Edit</text>
					</widget>
					<widget pos="85,0" size="44x24" type="*glfw.menuBarItem">
						<text pos="8,4" size="28x16">Help</text>
					</widget>
				</container>
				<widget pos="8,24" size="79x105" type="*widget.Menu">
