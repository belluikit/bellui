				<widget size="130x105" type="*widget.Scroll">
					<widget size="130x105" type="*widget.menuBox">
						<rectangle fillColor="rgba(42,42,42,255)" radius="4" size="130x105"/>
						<container size="130x105">
							<widget size="130x32" type="*widget.menuItem">
								<text pos="8,8" size="114x16">A</text>
							</widget>
							<widget pos="0,36" size="130x32" type="*widget.menuItem">
								<text pos="8,8" size="114x16">B</text>
							</widget>
							<widget pos="0,72" size="130x32" type="*widget.menuItem">
								<text pos="8,8" size="114x16">C</text>
							</widget>
						</container>
					</widget>
				</widget>
			</widget>
		</widget>
