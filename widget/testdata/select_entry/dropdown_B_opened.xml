<canvas padded size="150x200">
	<content>
		<widget pos="10,10" size="130x32" type="*widget.SelectEntry">
			<rectangle fillColor="inputBackground" pos="2,2" radius="4" size="126x28"/>
			<widget pos="2,2" size="90x28" type="*widget.Scroll">
				<widget size="90x28" type="*widget.entryContent">
					<widget size="90x28" type="*widget.RichText">
						<text pos="8,6" size="8x16">B</text>
					</widget>
				</widget>
			</widget>
			<rectangle pos="1,1" radius="4" size="127x29" strokeColor="inputBorder" strokeWidth="2"/>
